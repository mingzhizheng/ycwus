# Production Environment Variables
# Copy to .env.prod and fill in real values
# chmod 600 .env.prod — never commit to git

# === Database ===
DB_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
DATABASE_URL=postgresql+asyncpg://dyms:${DB_PASSWORD}@db:5432/dyms
DATABASE_URL_SYNC=postgresql://dyms:${DB_PASSWORD}@db:5432/dyms

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === JWT ===
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_48
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# === File Storage ===
UPLOAD_DIR=/uploads
UPLOAD_MAX_SIZE_MB=20
CLOUD_BACKUP_ENABLED=false

# === Email ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dyms@missgtrading.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@missgtrading.com
SMTP_USE_TLS=true

# === Application ===
DEFAULT_FACILITY_ID=1
APP_ENV=production
LOG_LEVEL=INFO
